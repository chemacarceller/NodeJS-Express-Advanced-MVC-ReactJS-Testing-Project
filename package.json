{
  "name": "AMVC_ReactJS_Testing",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix frontend",
    "build:react": "npm run build --prefix frontend",
    "dev:react": "npx vite build --watch --config frontend/vite.config.js",
    "dev:node": "cross-env DEBUG=mi-servidor:* node --watch ./bin/www",
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:node\"",
    "logs": "pm2 logs AMVC_ReactJS_Testing",
    "stop": "pm2 stop AMVC_ReactJS_Testing",
    "restart": "npm run build:react && cross-env NODE_ENV=production pm2 restart AMVC_ReactJS_Testing --update-env",
    "start": "npm run build:react && cross-env NODE_ENV=production pm2 start ./bin/www --name AMVC_ReactJS_Testing"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "dotenv": "^18.0.9",
    "ejs": "^6.0.1",
    "express": "^4.22.3",
    "express-ejs-layouts": "^2.5.1",
    "http-errors": "~1.6.3",
    "mongoose": "^9.10.1",
    "morgan": "^1.12.1",
    "ollama": "^0.6.4",
    "pug": "^3.0.4",
    "say": "^0.16.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0"
  }
}